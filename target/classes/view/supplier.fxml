<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SupplierController" spacing="14" styleClass="page">
    <Label text="Supplier Management" styleClass="page-title"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Nama Supplier" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Contoh: Supplier Beras Makmur" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Kontak" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="contactField" promptText="No HP / email" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Alamat" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="addressArea" prefRowCount="2" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Status" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="statusCombo" prefWidth="160" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Simpan" onAction="#save" styleClass="primary-button"/>
        <Button text="Hapus" onAction="#delete" styleClass="danger-button"/>
        <Button text="Bersihkan" onAction="#clear" styleClass="secondary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Supplier" prefWidth="220"/>
            <TableColumn fx:id="contactColumn" text="Kontak" prefWidth="180"/>
            <TableColumn fx:id="addressColumn" text="Alamat" prefWidth="330"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
